generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SystemControlCenter {
  id                    Int     @id @default(1)
  enableOtpForGuest     Boolean @default(false)
  defaultLanguage       String  @default("BN")
  heroYoutubeUrl        String  @default("https://www.youtube.com/watch?v=default")
  maskCustomerData      Boolean @default(true)
  disableLiveCourierAPI Boolean @default(true)
  paperSizeMode         String  @default("POS")
  invoicePrefix         String  @default("FK")
  useFreeWhatsAppOnly   Boolean @default(true)
  useGoogleSMTP         Boolean @default(true)
  minAmountForPaidSMS   Int     @default(2000)
  strictTxnUniqueCheck  Boolean @default(true)
  autoAdjustPrice       Boolean @default(true)
  qrCodeDestination     String  @default("TRACK")
  enableReviews         Boolean @default(false)
  enableCoupons         Boolean @default(false)
  enableWishlist        Boolean @default(false)
  enablePaymentGateway  Boolean @default(false)
  dhakaBaseCharge       Int     @default(75)
  dhakaExtraPerUnit     Int     @default(20)
  outsideBaseCharge     Int     @default(120)
  outsideExtraPerUnit   Int     @default(30)
  deliveryChargeMode        String  @default("NORMAL")
  normalDhakaBaseCharge     Int     @default(75)
  normalDhakaExtraPerUnit   Int     @default(20)
  normalOutsideBaseCharge   Int     @default(120)
  normalOutsideExtraPerUnit Int     @default(30)
}

model User {
  id                 Int                 @id @default(autoincrement())
  phone              String              @unique
  name               String?
  password           String?
  address            String?
  districtId         Int?
  district           String?
  upazila            String?
  role               Role                @default(CUSTOMER)
  isActive           Boolean             @default(true)
  otp                String?
  otpExpiry          DateTime?
  otpAttempts        Int                 @default(0)
  passwordResetRequested   Boolean   @default(false)
  passwordResetRequestedAt DateTime?
  
  walletBalance      Float               @default(0.0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  agentLogs          AgentLog[]
  createdOrders      Order[]             @relation("AgentToOrder")
  customerOrders     Order[]             @relation("CustomerToOrder")
  reviews            ProductReview[]
  walletTransactions WalletTransaction[]
}

model Category {
  id            Int        @id @default(autoincrement())
  name          String
  nameEn        String?
  slug          String     @unique
  description   String?
  displayOrder  Int        @default(0)
  isVisible     Boolean    @default(true)
  parentId      Int?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  parent        Category?  @relation("CategoryToSub", fields: [parentId], references: [id], onDelete: Cascade)
  subCategories Category[] @relation("CategoryToSub")
  products      Product[]
}
enum PriceType {
  FIXED
  NEGOTIABLE
}

model Product {
  id                  Int                      @id @default(autoincrement())
  name                String
  slug                String                   @unique
  description         String?
  nameEn              String?
  slugEn              String?                  @unique
  descriptionEn       String?
  nameBanglish        String?
  categoryId          Int?
  pricePerUnit        Float
  discountPrice       Float?
  unit                String                   @default("কেজি")
  stockQty            Float
  isOutOfStockVisible Boolean                  @default(true)
  isFeatured          Boolean                  @default(false)
  isTopSeller         Boolean                  @default(false)
  priceType           PriceType                @default(FIXED)
  isActive            Boolean                  @default(true)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  orderItems          OrderItem[]
  category            Category?                @relation(fields: [categoryId], references: [id])
  batches             ProductBatch[]
  images              ProductImage[]
  packagingRecipes    ProductPackagingRecipe[]
  reviews             ProductReview[]
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  imageUrl  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductBatch {
  id               Int      @id @default(autoincrement())
  productId        Int
  batchNumber      String
  productionDate   DateTime
  expiryDate       DateTime
  quantityProduced Float
  notes            String?
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PackagingMaterial {
  id         Int                      @id @default(autoincrement())
  itemName   String
  stockCount Int                      @default(0)
  alertLimit Int                      @default(50)
  unitCost   Float
  recipes    ProductPackagingRecipe[]
}

model ProductPackagingRecipe {
  id           Int               @id @default(autoincrement())
  productId    Int
  materialId   Int
  quantityUsed Int               @default(1)
  material     PackagingMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductReview {
  id         Int      @id @default(autoincrement())
  productId  Int
  userId     Int
  rating     Int
  comment    String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Coupon {
  id             Int          @id @default(autoincrement())
  code           String       @unique
  discountType   DiscountType
  discountValue  Float
  minOrderAmount Float        @default(0)
  maxDiscount    Float?
  usageLimit     Int?
  usedCount      Int          @default(0)
  isActive       Boolean      @default(true)
  expiryDate     DateTime?
  createdAt      DateTime     @default(now())
  orders         Order[]
}

model Order {
  id                Int             @id @default(autoincrement())
  customerId        Int
  orderSource       OrderSource     @default(WEBSITE)
  createdById       Int
  deliveryAddress   String
  customerNote      String?
  internalNote      String?
  totalProductPrice Float
  deliveryCharge    Float
  discountAmount    Float           @default(0.0)
  couponId          Int?
  finalCodAmount    Float
  courierProvider   String?
  courierTrackingId String?         @unique
  orderStatus       OrderStatus     @default(PENDING)
  paymentMethod     PaymentMethod   @default(COD)
  paymentStatus     PaymentStatus   @default(PENDING)
  gatewayName       String?
  gatewayTxnId      String?         @unique
  gatewayRef        String?
  paymentAmountPaid Float           @default(0.0)
  dailySeq          Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  courierSummary    CourierSummary?
  invoice           Invoice?
  coupon            Coupon?         @relation(fields: [couponId], references: [id])
  creator           User            @relation("AgentToOrder", fields: [createdById], references: [id])
  customer          User            @relation("CustomerToOrder", fields: [customerId], references: [id], onDelete: Cascade)
  orderItems        OrderItem[]
}

model OrderItem {
  id         Int     @id @default(autoincrement())
  orderId    Int
  productId  Int
  quantity   Float
  finalPrice Float
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model CourierSummary {
  id              Int      @id @default(autoincrement())
  orderId         Int      @unique
  courierStatus   String
  collectedAmount Float    @default(0.0)
  codFee          Float    @default(0.0)
  deliveryCharge  Float    @default(0.0)
  netPayout       Float    @default(0.0)
  isDiscrepancy   Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Invoice {
  id             Int      @id @default(autoincrement())
  orderId        Int      @unique
  invoiceNumber  String   @unique
  subTotal       Float
  deliveryCharge Float
  discountAmount Float    @default(0.0)
  advancePaid    Float    @default(0.0)
  finalCodAmount Float
  barcodeString  String
  qrCodeUrl      String
  printCount     Int      @default(0)
  lastPrintedBy  Int?
  secureToken    String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model NavigationMenu {
  id           Int              @id @default(autoincrement())
  title        String
  titleEn      String?
  url          String
  displayOrder Int              @default(0)
  isVisible    Boolean          @default(true)
  parentId     Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  parentMenu   NavigationMenu?  @relation("MenuToSubMenu", fields: [parentId], references: [id], onDelete: Cascade)
  subMenus     NavigationMenu[] @relation("MenuToSubMenu")
}

model AgentLog {
  id         Int      @id @default(autoincrement())
  agentId    Int
  action     String
  details    String
  targetId   Int?
  targetType String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  agent      User     @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model WalletTransaction {
  id        Int           @id @default(autoincrement())
  userId    Int
  amount    Float
  type      WalletTxnType
  reason    String
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Blog {
  id            Int      @id @default(autoincrement())
  title         String
  slug          String   @unique
  content       String
  titleEn       String?
  slugEn        String?  @unique
  contentEn     String?
  titleBanglish String?
  image         String?
  category      String
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum Role {
  CUSTOMER
  AGENT
  ADMIN
  SUPER_ADMIN
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERY_ONGOING
  DELIVERED
  RETURNED
  CANCELLED
}

enum OrderSource {
  WEBSITE
  MESSENGER
  WHATSAPP
  CALL
}

enum PaymentMethod {
  COD
  GATEWAY
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL_PAID
}

enum WalletTxnType {
  CREDIT
  DEBIT
}

model YoutubeVideo {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  youtubeUrl   String
  platform     String   @default("YOUTUBE")
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  heroOrder    Int?     // null = হিরো স্লাইডে নেই, সংখ্যা = হিরো রোটেশনে ক্রম (০,১,২,৩)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  titleEn      String?
  descriptionEn String?
}

model GalleryItem {
  id          Int                @id @default(autoincrement())
  title       String
  titleEn     String?
  slug        String             @unique
  slugEn      String?            @unique
  description String?
  descriptionEn String?
  displayOrder Int               @default(0)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  images      GalleryItemImage[]
}

model GalleryItemImage {
  id            Int          @id @default(autoincrement())
  galleryItemId Int
  imageUrl      String
  displayOrder  Int          @default(0)
  createdAt     DateTime     @default(now())
  galleryItem   GalleryItem  @relation(fields: [galleryItemId], references: [id], onDelete: Cascade)
}

model BlogCategory {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  nameEn String?
}